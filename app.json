{
  "expo": {
    "name": "Balanz",
    "slug": "balanz-app",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "balanz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.balanz.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#09090b"
      },
      "package": "app.balanz.mobile",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#09090b"
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Balanz usa Face ID para proteger tus datos financieros."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Balanz usa la cámara para guardar la foto del ticket.",
          "photosPermission": "Balanz accede a tus fotos para adjuntar tickets."
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
